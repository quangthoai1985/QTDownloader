{
  "manifest_version": 3,
  "name": "TDownload — Tích hợp trình duyệt",
  "short_name": "TDownload",
  "version": "1.0.2",
  "description": "Chuyển tải xuống từ trình duyệt sang TDownload (đa kết nối, tải tiếp, hàng đợi) và phát hiện video HLS/MP4.",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest", "scripting", "activeTab",
                  "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "TDownload",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
